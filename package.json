{
  "name": "dsh-ecc-skills",
  "description": "ECC (227k-star operator system) skills for DeepSeek Harness — progressive port of 274 curated single-file skills (agentic engineering, evaluation, testing, patterns, vertical domains, docs). Adapted from affaan-m/ECC (MIT)",
  "version": "0.5.4",
  "private": false,
  "type": "module",
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongyijie85/dsh-ecc.git"
  },
  "homepage": "https://github.com/gongyijie85/dsh-ecc",
  "bugs": {
    "url": "https://github.com/gongyijie85/dsh-ecc/issues"
  },
  "scripts": {
    "verify": "node scripts/verify-provider.mjs",
    "prepublishOnly": "node scripts/verify-provider.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "skills",
    "ecc",
    "agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.0.1-rc.1": "incompatible",
        "0.0.1-rc.2": "incompatible",
        "0.0.1-rc.5": "incompatible",
        "0.1.0-rc.2": "incompatible",
        "0.1.0-rc.3": "incompatible",
        "0.1.0-rc.6": "compatible",
        "0.1.0-rc.7": "compatible",
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible",
        "0.1.2-alpha.2": "compatible",
        "0.1.2-alpha.3": "compatible",
        "0.1.2-alpha.4": "compatible",
        "0.1.2-alpha.5": "compatible",
        "0.1.2-rc.1": "compatible",
        "0.1.3-alpha.2": "compatible",
        "0.1.5-alpha.1": "compatible",
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  }
}
